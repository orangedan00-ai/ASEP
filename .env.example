# ASEP configuration
ASEP_HOST=127.0.0.1
ASEP_PORT=8000
ASEP_DEBUG=false

# Non-loopback deployments require HTTP Basic Auth. Keep ASEP on 127.0.0.1
# unless remote access is explicitly needed.
ASEP_AUTH_USER=asep
ASEP_AUTH_PASSWORD=

# Cloud LLM — primary reasoning engine when configured
# gpt-5.6-luna is the current documented Luna model ID.
OPENAI_API_KEY=
ASEP_CLOUD_MODEL=gpt-5.6-luna

# Lightweight Local LLM — used for preprocessing/normalization on older laptops
# X230 recommendation: keep the model tiny and context/output small.
ASEP_LOCAL_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
ASEP_LOCAL_MODEL=qwen3:0.6b
ASEP_LOCAL_NUM_CTX=2048
ASEP_LOCAL_NUM_PREDICT=256
ASEP_LOCAL_NUM_THREADS=2

# Intelligence Engine
# auto = cloud (if API key set) -> claude_code (if enabled+installed) -> local
ASEP_LLM_MODE=auto
ASEP_INTELLIGENCE_CONTEXT_CHARS=30000

# Claude Code — reasoning backend using YOUR OWN Claude Code subscription
# (Pro/Max login via the `claude` CLI), not a separate API key.
# Prerequisite: install Claude Code once, then log in interactively:
#   curl -fsSL https://claude.ai/install.sh | bash
#   claude          # run once, interactively, to log in with your subscription
# This backend has zero file/bash/tool access by design (reasoning only,
# same contract as Cloud/Local above) — see app/llm.py::ask_claude_code.
ASEP_CLAUDE_CODE_ENABLED=false
ASEP_CLAUDE_CODE_BINARY=claude
ASEP_CLAUDE_CODE_TIMEOUT=120
ASEP_CLAUDE_CODE_MAX_TURNS=4
# Set ASEP_LLM_MODE=claude_code above to force this backend instead of auto-detect.

# Local shell executor
ASEP_SHELL_ENABLED=false
ASEP_SHELL_TIMEOUT=120
ASEP_SHELL_CWD=

# Root execution always requires explicit user approval.
ASEP_ROOT_APPROVAL_REQUIRED=true

# Evidence-driven Kali Tool Engine
ASEP_TOOL_TIMEOUT=300
ASEP_INTERNET_RESEARCH_ENABLED=true

# Real Kali evidence chain
ASEP_AUTO_CHAIN_ENABLED=true

# ASEP self-modifying capability
ASEP_SELF_MODIFY_ENABLED=false
ASEP_SELF_MODIFY_APPROVAL_REQUIRED=true
ASEP_SELF_MODIFY_MAX_FILE_BYTES=500000

# v2.9.10 automatic comprehensive local service inventory
ASEP_AUTO_DEEP_SCAN_ENABLED=true
ASEP_AUTO_DEEP_SCAN_NEW_HOSTS=true
